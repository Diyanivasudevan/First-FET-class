l accounts in the Account Management section of the profile settings.";var fce="Microsoft Learn will send email to you at the email you provide below.",Ah="Microsoft Privacy Notice",hce="You need to agree with the Microsoft Privacy Notice to keep your profile and relating data.",bce="Miles";var kh="{numberOfMinutes} min";var Ku="{numberOfMinutes} mins",YF="Minute",Tm="Minutes";var _ce="{duration} minutes ago";var So="Module",yce="Module assessment",vce="The questions and answer choices in this module assessment were generated using AI and reviewed by a human author.",xce="AI-generated content";var Tce="Provide feedback",wce="Give as many details as you can, but don't include any private or sensitive information",Sce="Privacy Statement",Cce="Provide feedback about AI-generated content",Ece="Your feedback will be used to improve Microsoft products and services.",Ace="Content errors",kce="Design and usability errors",Ice="Other errors",Lce="Scoring errors",Pce="Is this content helpful to you?";var Rce="Assess your understanding of this module. Sign in and answer all questions correctly to earn a pass designation on your profile.";var Mce="Collapse learning object {objectiveId}",$ce="Try again",Dce="Module assessment hash: {hash}";var Nce="no AI generated questions found for this module assessment in locale {locale}, branch {branch}.",WF="Great job! You passed the module assessment.",KF='Achieve a score of {passingCriteria} or higher to pass. Click "Retake" to try again, or "Next" to finish the module. You can retake the module assessment at any time.',Fce='Achieve a score of {passingCriteria} to pass. Click "Retake" to try again, or "Next" to finish the module. You can retake the module assessment at any time.',fk="Module assessment passed",Oce="All module assessments passed",Uce="Question ID: {questionId}",qce="This assessment evaluates your understanding of the module. Unlike before, you won't get feedback on individual answers\u2014just whether they're right or wrong. This is meant to measure what you've learned. Take time to review the module materials before starting.",Hce="<empty>";var hk="Retake",Bce="Your progress has been saved.",zce="to save progress.",Gce="Score",Vce="Sign-in successful",Qce="Review mode",jce="Learning objective",Yce="Rationale",Wce="Take the module assessment",Kce="Marked to be hidden",JF="Hidden to users",ZF="Visible to users",Jce="Marked to be visible",Ih="Regenerate AI Content",bk="Login GitHub to Regen Or Hide Questions",XF="Moderation functions are not available for you. Please make sure:you have the push permission to the repository {repoName}, and you have authorized Microsoft Docs during GitHub single sign-on.",Zce="Please login GitHub and authorize to enable your moderation functions in review mode.",Xce="\u2018Update question visibility\u2019 button:\u201CYou can use this function to hide poor questions from users. First, select the questions, then update their visibility. Note that each learning objective requires at least 3 good questions.",eue="\u2018Regenerate AI Content\u2019 button:\u201CYou can use this function to regenerate all content for this module assessment, including learning objectives and questions. If any learning objective has fewer than 3 good questions, you need to run this function. Note that after regeneration, feedback will persist if you have filled out and submitted the form, but marking a question to hide will not persist.",eO="Continue on GitHub",tue="To update question visibility, we will need to make changes to the file in GitHub on your behalf. Please click 'Continue on GitHub' to process the change and check the build status on GitHub.",nue="No enough remaining questions for learning objective {index}. Click 'OK' to go back to re-select.",oue="To trigger the regeneration process, we will need to make changes to the file in GitHub on your behalf. Please click 'Continue on GitHub' to proceed the change and check the build status on GitHub.",Lh="Update question visibility",rue="Login failed on GitHub. Please retry.",sue="Github File Not Found. Please retry.",iue="Can't fetch the file from GitHub. Please retry.",aue="You don't have writer permission on this repo:{repoName}.",tO="{count} module",nO="{count} modules",lue="Module incomplete",cue="This module helps prepare you for {exam}.",uue="{platformName} Module Reference",Ph="Modules",due="Modules in this learning path",pue="You have been redirected to the newest product version available for this page.";var mue="{duration} months ago";var qx="More";var es="Next",gue="Next learning path:",fue="Next module:";var hue="Next unit",Hs="No",bue="New collection";var _ue="No current courses available for this certification";var yue='No items in this section. Move items here from other sections or add items from the <a href="{link}">Learn training browse page</a>.';var vue="Learning paths or modules are not yet available for this",xue="none";var ts="No results",Bs="No results found";var Tue="No suggestions";var wue="No, thanks",Sue="Note";var Cue="Very satisfied",Eue="Satisfied",Aue="Neither satisfied nor dissatisfied",kue="Dissatisfied",Iue="Very Dissatisfied";var lo="OK",Lue="OK, got it.";var Pue="Please edit your interests";var Rue="We don't currently have anything that fits your selections.",Mue="1 Module",$ue="1 Unit";var Due="Open search";var Nue="{productName} feedback",Fue="{productName} is an open source project. Select a link to provide feedback:";var Oue='I will receive information, tips, and offers about Microsoft Learn and other Microsoft products and services. <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>',Uue="I would like information, tips, and offers about Microsoft Learn and other Microsoft products and services.",que='I would like information, tips, and offers about Microsoft Learn and other Microsoft products and services. <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>',Hue="I would like to hear from Microsoft and its family of companies via email and phone about Microsoft Learn and other Microsoft products and services. To withdraw consent or manage your contact preferences, visit the Promotional Communications Manager.",Bue='I would like to hear from Microsoft and its family of companies via email and phone about Microsoft Learn and other Microsoft products and services. To withdraw consent or manage your contact preferences, visit the <a href="https://go.microsoft.com/fwlink/?linkid=243189">Promotional Communications Manager.</a> <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>',zue="I would like information, tips, and offers about Microsoft Learn and other Microsoft products and services.",Gue='I would like information, tips, and offers about Microsoft Learn and other Microsoft products and services. <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>',Vue='Participation requires transferring your personal data to other countries in which Microsoft operates, including the United States. By submitting this form, you agree to the transfer of your data outside of China. <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>',oO="I agree to receiving marketing information and use of my personal information for marketing purposes (required):",Que='<div class="content"><ul><li><span class="font-weight-bold font-size-lg">Consent to Receive Marketing</span>: The information collected may be used for Microsoft to send you information, tips, and offers about Microsoft Learn and other Microsoft products and services. </li><li> Items of Personal Information to be Collected: First Name, Last Name, Email Address, Phone Number, Company name and size, Job Title, Country/Region of residence, and any other fields visible on this form. </li><li>Purpose of Collection and Use: <span class="font-weight-bold font-size-lg">To contact you for marketing purposes </span></li><li> Retention/Use Period of Personal Information: <span class="font-weight-bold font-size-lg">As long as needed to provide the service(s) you are requesting </span></li></ul></div> You have the right to refuse the collection and use of personal information for marketing purposes, and receiving marketing information as set forth above. However, if you refuse, you may not be able to receive the benefits described under Purpose of Collection & Use. <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>';var Rh="Select a country/region";var jue="Open Cloud Shell",Yue="Optional";var _k="{label} (optional)";var Wue="or";var yk="Other";var Kue="Overall, how satisfied or dissatisfied are you with Microsoft Learn?";var Jue="Overview",Zue="Overview for: {title}",vk="Package",rO="{platformName} Package Reference";var Hx="Page {pageNumber} of {numberOfPages}";var sO="pagination";var Bx="Past {numberOfDays} days";var Mh="Plan";var Xue="Please fill out this field.",zx="Please provide an email address.",ede="Please provide feedback on how we can improve this content. If applicable, provide the first part of the sentence or string at issue.";var tde="Print";var nde="Print is disabled for content requiring authorization.",xk="Privacy policy",ode="Poor",rde="We're sorry. The lab environment needed to complete the exercises in this unit is temporarily unavailable.",Tk="Launch lab",sde="Loading lab...";var iO="This unit includes a lab to complete.",aO="Use the free resources provided in the lab to complete the exercises in this unit. You will not be charged <strong>for the lab environment</strong>; however, you may need to bring your own subscription depending on the lab.",ide="Lab will launch in a new window.",ade="Yes, start a new lab",lde="A lab for a different unit is already active",cde="You currently have a lab open for another unit ({lab-name}). Would you like to discard your pre-existing lab and start a new lab for this unit?",ude="Retry launching lab",dde="Sign in to launch the lab",pde="Start lab",mde="This lab is busy with too many active users. Please wait a few minutes and try again.",gde="There was an error starting the lab. Please try again later.";var lO="<strong>Option {number}:</strong> Prerequisite certification";var wk="Preview";var Nr="Previous";var fde="{productName} users:";var hde="Profile";var bde="Provide product feedback";var Sk="Q&A";var _de="asked";var yde="answers",vde="comments",xde="votes";var cO="Report a concern",uO="Report reason";var Tde=`<a class='docs-sign-in' href="#">Sign in</a> to opt into email updates on your reported concern`,wde="Allow Microsoft to contact me about this report",Sde="Full Name",Cde="Email",Ede='We will contact you through your personal account <span id="report-msa-email-account" class="font-weight-bold">{email}</span>',Ade='Microsoft is committed to helping our users and to protecting your privacy. You may read the <a href="https://privacy.microsoft.com/privacystatement">Microsoft Privacy Statement</a> if you would like more information on how we protect personal data.';var kde="1 out of {numberOfQuestions} questions is incorrect. Please correct question {lastIncorrectQuestionNumber}.",Ide="{numberOfIncorrectQuestions} out of {numberOfQuestions} questions are incorrect. Please correct questions {incorrectQuestionNumbers} and {lastIncorrectQuestionNumber}.",Lde="Question",dO="Question author";var Pde="Question already answered.";var Rde="Required question.",Mde="Optional question.";var $de="Radius";var pO="Read in English",Dde="Read in {language}";var _r="Reference";var Nde="References";var Ju="Refresh";var Fde="Register";var Ode="Related certification";var Ude="This module is part of these learning paths";var $h="remaining";var Ic="Remove",mO="Remove {itemName}",Ck="Renew";var Ek="Report a concern",qde="Select reason",gO="Adult and sexual",Hde="AI accuracy",fO="Child sexual exploitation and abuse imagery",hO="Coordination of harm",Bde="Defamation, impersonation, false information",bO="Bullying and harassment",_O="Graphic violence and gore",yO="Hate speech and discrimination",vO="Non-consensual intimate imagery & intimate extortion",zde="Off topic or irrelevant posts",xO="Other Terms of Use or Code of Conduct violation",Gde="Personal or sensitive user information",TO="Profanity and vulgarity",wO="Sexual solicitation",Vde="Spam";var SO="Suicide and self-injury",CO="Terrorism and violent extremism",EO="Trafficking",AO="Violent threats, incitement, and glorification of violence";var Dh="Required fields are marked with an asterisk";var Qde="Resources";var kO="Restart";var jde="{numberOfResults} result",IO="{numberOfResults} results",Zu="Resume",Ak="Retake";var Yde="Return to module";var Gx="We're encountering an issue with the security verification process required to activate the resource. Please retry after 10 minutes.",kk=`We have reviewed your appeal and determined that your account has violated our <a href="https://learn.microsoft.com/en-us/legal/termsofuse" data-linktype="external">Terms of Use</a>. Your interactive resource access will not be reinstated. However, you can continue to access Microsoft Learn's training content. Many module exercises can be completed using your personal subscription, but charges may apply, and you may need to modify the instructions to work with your subscription.`;var Wde='For more information, please check the <a href="https://learn.microsoft.com/en-us/training/support/troubleshooting">troubleshooting guidance page</a>.',it="Save";var Nh="Save successful.",Kde="Score:",Jde="Skill";var LO="Add to Plans",PO="Added to Plans",Zde="Manage {title} in Plans",Xde="Add {title} to a plan";var RO="Copy plan";var epe="Milestone {number}",tpe='Added to <a href="{url}" class="has-text-tertiary-invert text-decoration-underline">{collectionName}</a>',npe='Added to <a href="{url}" class="has-text-tertiary-invert text-decoration-underline">Plans</a>';var ope='Removed from <a href="{url}" class="has-text-tertiary-invert text-deco